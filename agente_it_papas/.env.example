# ---------------------------------------------------------------------------
# Telegram — cuenta de usuario dedicada del agente (NO es un bot)
# api_id / api_hash se sacan de https://my.telegram.org -> API development tools
# ---------------------------------------------------------------------------
TG_API_ID=
TG_API_HASH=
# Lo genera scripts/generar_sesion.py. Equivale a estar logueado: trátalo
# como una contraseña.
TG_SESSION_STRING=
TG_SESSION_NAME=agente_it

# IDs de chat autorizados, separados por coma. Es el candado que impide que
# un desconocido le hable al agente. Déjalo vacío SOLO mientras pruebas.
# Para un grupo el id es negativo, ej: -1001234567890
TG_ALLOWED_CHATS=

# ---------------------------------------------------------------------------
# Gemini — el cerebro. https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---------------------------------------------------------------------------
# Fish Audio — la voz. https://fish.audio -> API Keys
# ---------------------------------------------------------------------------
FISH_API_KEY=
# s2.1-pro-free es gratis hasta el 31 de agosto de 2026.
# Si se acaba, cambiar a s2.1-pro (US$15 por millón de bytes).
FISH_MODEL=s2.1-pro-free
# Lo entrega scripts/clonar_voz.py. Vacío = voz genérica.
FISH_VOICE_ID=

# ---------------------------------------------------------------------------
# n8n — tickets y alertas (opcional; sin esto el agente igual funciona)
# ---------------------------------------------------------------------------
N8N_TICKET_URL=
N8N_TICKET_SECRET=

# ---------------------------------------------------------------------------
# Ajuste fino de la conversación
# ---------------------------------------------------------------------------
# Silencio en ms para dar por terminado el turno. Súbelo si el agente
# interrumpe a tu papá cuando él está pensando.
SILENCE_MS=900
MIN_SPEECH_MS=350
BARGE_IN_MS=450
VAD_AGGRESSIVENESS=2
IDLE_HANGUP_S=120
LOG_LEVEL=INFO
